{% if section.settings.show_section %}
<div class="trust-bar-{{ section.id }}{% if section.settings.background_style == 'transparent' %} trust-bar--transparent{% endif %}"
     aria-label="Vertrauenssignale">

  <div class="trust-bar__row">

    <span class="trust-bar__item">{{ section.settings.item_1 | escape }}</span>

    <span class="trust-bar__dot" aria-hidden="true">·</span>

    <span class="trust-bar__item">
      <span class="trust-bar__stars" aria-hidden="true">★★★★★</span>{{ section.settings.item_2 | escape }}
    </span>

    <span class="trust-bar__dot" aria-hidden="true">·</span>

    <span class="trust-bar__item">{{ section.settings.item_3 | escape }}</span>

    <span class="trust-bar__dot" aria-hidden="true">·</span>

    <span class="trust-bar__item">{{ section.settings.item_4 | escape }}</span>

    <span class="trust-bar__dot" aria-hidden="true">·</span>

    <span class="trust-bar__item">{{ section.settings.item_5 | escape }}</span>

  </div>

</div>
{% endif %}

<style>
  .trust-bar-{{ section.id }} {
    border-top: 0.5px solid rgba(var(--color-foreground), 0.15);
    border-bottom: 0.5px solid rgba(var(--color-foreground), 0.15);
    background-color: var(--color-background-2, rgba(var(--color-foreground), 0.04));
    width: 100%;
  }

  .trust-bar-{{ section.id }}.trust-bar--transparent {
    background-color: transparent;
  }

  .trust-bar-{{ section.id }} .trust-bar__row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    height: 32px;
    padding: 0 16px;
    gap: 0;
  }

  .trust-bar-{{ section.id }} .trust-bar__row::-webkit-scrollbar {
    display: none;
  }

  .trust-bar-{{ section.id }} .trust-bar__item {
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 400;
    line-height: 32px;
    white-space: nowrap;
    color: rgba(var(--color-foreground), 0.75);
  }

  .trust-bar-{{ section.id }} .trust-bar__dot {
    font-family: var(--font-body-family);
    font-size: 12px;
    line-height: 32px;
    color: rgba(var(--color-foreground), 0.3);
    margin: 0 12px;
    flex-shrink: 0;
  }

  .trust-bar-{{ section.id }} .trust-bar__stars {
    color: #BA7517;
    font-size: 11px;
    margin-right: 4px;
  }
</style>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section-trust-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Anzeigen",
      "default": true
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Hintergrund",
      "options": [
        { "value": "subtle", "label": "Subtil" },
        { "value": "transparent", "label": "Transparent" }
      ],
      "default": "subtle"
    },
    {
      "type": "header",
      "content": "Inhalte"
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
      "default": "Bekannt aus RTL · SAT1 · SWR1"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Item 2",
      "info": "Sterne werden automatisch vorangestellt",
      "default": " 4,8 — Über 1.000 Kunden"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Item 3",
      "default": "90 Tage Geld-zurück — kein Formular"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Item 4",
      "default": "Gratis Versand ab 35 €"
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Item 5",
      "default": "Entwickelt von Dr. med. Limmroth"
    }
  ],
  "presets": [
    {
      "name": "Trust Bar"
    }
  ]
}
{% endschema %}
