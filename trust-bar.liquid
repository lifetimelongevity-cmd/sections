{% if section.settings.show_section %}
<div class="trust-bar-{{ section.id }}{% if section.settings.background_style == 'subtle' %} trust-bar--subtle{% endif %}">
  <div class="trust-bar__inner" role="list" aria-label="Vertrauenssignale">

    <div class="trust-bar__cell" role="listitem">
      <div class="trust-bar__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.25"/>
          <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="trust-bar__text">
        <span class="trust-bar__label">{{ section.settings.signal_1_label | escape }}</span>
        <span class="trust-bar__value">{{ section.settings.signal_1_value | escape }}</span>
      </div>
    </div>

    <div class="trust-bar__cell" role="listitem">
      <div class="trust-bar__text">
        <span class="trust-bar__label trust-bar__label--stars"><span class="trust-bar__stars" aria-hidden="true">★★★★★</span> {{ section.settings.signal_2_label | escape }}</span>
        <span class="trust-bar__value">{{ section.settings.signal_2_value | escape }}</span>
      </div>
    </div>

    <div class="trust-bar__cell" role="listitem">
      <div class="trust-bar__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3.5" y="7" width="9" height="7" rx="1.25" stroke="currentColor" stroke-width="1.25"/>
          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <circle cx="8" cy="10.5" r="1" fill="currentColor"/>
        </svg>
      </div>
      <div class="trust-bar__text">
        <span class="trust-bar__label">{{ section.settings.signal_3_label | escape }}</span>
        <span class="trust-bar__value">{{ section.settings.signal_3_value | escape }}</span>
      </div>
    </div>

    <div class="trust-bar__cell" role="listitem">
      <div class="trust-bar__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1.5" y="5.5" width="9" height="6" rx="1" stroke="currentColor" stroke-width="1.25"/>
          <path d="M10.5 7.5h1.5l2 2v2h-3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="4.5" cy="12" r="1.25" stroke="currentColor" stroke-width="1"/>
          <circle cx="11.5" cy="12" r="1.25" stroke="currentColor" stroke-width="1"/>
        </svg>
      </div>
      <div class="trust-bar__text">
        <span class="trust-bar__label">{{ section.settings.signal_4_label | escape }}</span>
        <span class="trust-bar__value">{{ section.settings.signal_4_value | escape }}</span>
      </div>
    </div>

  </div>
</div>
{% endif %}

<style>
  .trust-bar-{{ section.id }} {
    border-top: 0.5px solid rgba(var(--color-foreground), 0.2);
    border-bottom: 0.5px solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    width: 100%;
  }

  .trust-bar-{{ section.id }}.trust-bar--subtle {
    background: var(--color-background-2, rgba(var(--color-foreground), 0.04));
  }

  .trust-bar-{{ section.id }} .trust-bar__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    /* Use background-color gap trick for dividers */
    gap: 0.5px;
    background-color: rgba(var(--color-foreground), 0.15);
  }

  .trust-bar-{{ section.id }} .trust-bar__cell {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--color-background);
    min-width: 0;
  }

  .trust-bar-{{ section.id }}.trust-bar--subtle .trust-bar__cell {
    background: var(--color-background-2, color-mix(in srgb, rgb(var(--color-foreground)) 4%, rgb(var(--color-background))));
  }

  .trust-bar-{{ section.id }} .trust-bar__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 0.5px solid rgba(var(--color-foreground), 0.15);
    color: rgba(var(--color-foreground), 0.55);
  }

  .trust-bar-{{ section.id }} .trust-bar__stars {
    color: #BA7517;
  }

  .trust-bar-{{ section.id }} .trust-bar__icon svg {
    display: block;
  }

  .trust-bar-{{ section.id }} .trust-bar__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .trust-bar-{{ section.id }} .trust-bar__label,
  .trust-bar-{{ section.id }} .trust-bar__value {
    display: block;
    font-family: var(--font-body-family);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .trust-bar-{{ section.id }} .trust-bar__label {
    font-size: 11px;
    color: rgba(var(--color-foreground), 0.55);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .trust-bar-{{ section.id }} .trust-bar__value {
    font-size: 13px;
    font-weight: 500;
    color: rgb(var(--color-foreground));
    margin-top: 1px;
  }

  @media (min-width: 768px) {
    .trust-bar-{{ section.id }} .trust-bar__inner {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: 1fr;
    }

    .trust-bar-{{ section.id }} .trust-bar__cell {
      justify-content: center;
      text-align: left;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section-trust-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Abschnitt anzeigen",
      "default": true
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Hintergrund",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "subtle", "label": "Subtil" }
      ],
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Signal 1"
    },
    {
      "type": "text",
      "id": "signal_1_label",
      "label": "Signal 1 Label",
      "default": "Bekannt aus"
    },
    {
      "type": "text",
      "id": "signal_1_value",
      "label": "Signal 1 Wert",
      "default": "RTL · SAT1 · SWR1"
    },
    {
      "type": "header",
      "content": "Signal 2"
    },
    {
      "type": "text",
      "id": "signal_2_label",
      "label": "Signal 2 Label",
      "default": "★★★★★ 4,8"
    },
    {
      "type": "text",
      "id": "signal_2_value",
      "label": "Signal 2 Wert",
      "default": "Über 1.000 Kunden"
    },
    {
      "type": "header",
      "content": "Signal 3"
    },
    {
      "type": "text",
      "id": "signal_3_label",
      "label": "Signal 3 Label",
      "default": "Risikofrei kaufen"
    },
    {
      "type": "text",
      "id": "signal_3_value",
      "label": "Signal 3 Wert",
      "default": "90 Tage Garantie"
    },
    {
      "type": "header",
      "content": "Signal 4"
    },
    {
      "type": "text",
      "id": "signal_4_label",
      "label": "Signal 4 Label",
      "default": "Versandkostenfrei"
    },
    {
      "type": "text",
      "id": "signal_4_value",
      "label": "Signal 4 Wert",
      "default": "Ab 35 € nach DE"
    }
  ],
  "presets": [
    {
      "name": "Trust Bar"
    }
  ]
}
{% endschema %}
