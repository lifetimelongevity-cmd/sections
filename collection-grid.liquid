{{ 'collection-grid.css' | asset_url | stylesheet_tag }}

<section
  id="shopify-section-{{ section.id }}"
  class="collection-grid-section section-{{ section.id }}"
  style="
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="collection-grid__inner page-width">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="collection-grid__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="collection-grid__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="collection-grid__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-grid__grid collection-grid__grid--{{ section.settings.columns_desktop }}-col">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- assign card_bg = block.settings.card_bg_color -%}
        {%- assign text_color = block.settings.text_color -%}
        {%- assign compare_color = block.settings.compare_price_color -%}

        <a
          href="{%- if product != blank -%}{{ product.url }}{%- elsif block.settings.custom_url != blank -%}{{ block.settings.custom_url }}{%- else -%}#{%- endif -%}"
          class="collection-grid__card collection-grid__card--{{ block.id }}"
          style="background-color: {{ card_bg }};"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.badge != blank -%}
            <span class="collection-grid__badge" style="color: {{ card_bg }};">
              {{ block.settings.badge | escape }}
            </span>
          {%- endif -%}

          <div class="collection-grid__card-body" style="color: {{ text_color }};">
            <h3 class="collection-grid__card-title" style="color: {{ text_color }};">
              {%- if product != blank -%}
                {{ product.title | escape }}
              {%- elsif block.settings.custom_title != blank -%}
                {{ block.settings.custom_title }}
              {%- endif -%}
            </h3>

            {%- assign subline = block.settings.subline -%}
            {%- if subline == blank and product != blank -%}
              {%- assign subline = product.metafields.custom.subline | default: product.description | strip_html | truncate: 60 -%}
            {%- endif -%}
            {%- if subline != blank -%}
              <p class="collection-grid__card-subline" style="color: {{ text_color }};">{{ subline }}</p>
            {%- endif -%}

            {%- if product != blank -%}
              <p class="collection-grid__card-price" style="color: {{ text_color }};">
                {%- if product.compare_at_price > product.price -%}
                  <span>From {{ product.price | money_without_trailing_zeros }}</span>
                  <s style="color: {{ compare_color }};">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- else -%}
                  <span>{{ product.price | money_without_trailing_zeros }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>

          <div class="collection-grid__card-image-wrap">
            {%- if product != blank and product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 1100
                | image_tag:
                  loading: 'lazy',
                  widths: '550, 750, 1100',
                  sizes: '(min-width: 750px) calc((100vw - 10rem) / {{ section.settings.columns_desktop }}), calc(50vw - 1.5rem)',
                  class: 'collection-grid__card-image',
                  alt: product.featured_image.alt | escape
              }}
            {%- elsif block.settings.custom_image != blank -%}
              {{
                block.settings.custom_image
                | image_url: width: 1100
                | image_tag:
                  loading: 'lazy',
                  widths: '550, 750, 1100',
                  sizes: '(min-width: 750px) calc((100vw - 10rem) / {{ section.settings.columns_desktop }}), calc(50vw - 1.5rem)',
                  class: 'collection-grid__card-image',
                  alt: block.settings.custom_title | escape
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'collection-grid__card-image collection-grid__card-image--placeholder' }}
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  .section-{{ section.id }} .collection-grid__heading {
    font-size: {{ section.settings.heading_size }}px;
  }
</style>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "header",
          "content": "Product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "subline",
          "label": "Subline / tagline",
          "info": "Short descriptor shown below the title. Falls back to product description if left blank."
        },
        {
          "type": "header",
          "content": "Override (no product selected)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom link URL"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image"
        },
        {
          "type": "header",
          "content": "Card colors"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background",
          "default": "#222222"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "compare_price_color",
          "label": "Compare-at price color",
          "default": "#dfdfdf"
        },
        {
          "type": "header",
          "content": "Badge"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "info": "e.g. NEW, SALE, LIMITED TIME"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Coffee",
            "subline": "Full-bodied coffee",
            "card_bg_color": "#926253",
            "text_color": "#ffffff",
            "compare_price_color": "#dfdfdf",
            "badge": "NEW"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Original",
            "subline": "Rich chocolate chai",
            "card_bg_color": "#222222",
            "text_color": "#ffffff",
            "compare_price_color": "#dfdfdf",
            "badge": "Most Popular"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Matcha",
            "subline": "Premium Japanese matcha",
            "card_bg_color": "#707956",
            "text_color": "#ffffff",
            "compare_price_color": "#8c9394"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Rest",
            "subline": "Nutty rooibos",
            "card_bg_color": "#5c587e",
            "text_color": "#ffffff",
            "compare_price_color": "#dfdfdf"
          }
        }
      ]
    }
  ]
}
{% endschema %}
